{
  "name": "orewosabake-workspace",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @orewosabake/web",
    "dev:api": "npm run dev --workspace @orewosabake/api",
    "build:web": "npm run build --workspace @orewosabake/web",
    "deploy:cloudflare": "node apps/web/scripts/require-head-tail-model.mjs && npm run typecheck:worker && npm run build:web && wrangler deploy --config apps/web/dist/worker/wrangler.json",
    "deploy:cloudflare:temporary": "node apps/web/scripts/require-head-tail-model.mjs && npm run typecheck:worker && npm run build:web && wrangler deploy --config apps/web/dist/worker/wrangler.json --temporary",
    "preview:cloudflare": "wrangler dev --config apps/web/dist/worker/wrangler.json",
    "typecheck:web": "npm run typecheck --workspace @orewosabake/web",
    "typecheck:api": "npm run typecheck --workspace @orewosabake/api",
    "typecheck:worker": "tsc --noEmit -p apps/web/tsconfig.worker.json"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
