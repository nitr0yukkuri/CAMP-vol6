{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orewosabake-k6-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-30",
  "durable_objects": {
    "bindings": [
      { "name": "GUIDE_SESSIONS", "class_name": "GuideSessionStore" }
    ]
  },
  "exports": {
    "GuideSessionStore": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "GEMINI_API_KEY": "k6-fake-local-only",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_TEST_MODE": "true",
    "GEMINI_TEST_API_URL": "http://127.0.0.1:8789/v1beta/models/gemini-3.5-flash-lite:generateContent",
    "GEMINI_TEST_TIMEOUT_MS": "750",
    "GEMINI_TEST_OVERALL_TIMEOUT_MS": "1200",
    "GEMINI_TEST_MAX_ATTEMPTS": "2",
    "GEMINI_TEST_RETRY_BASE_DELAY_MS": "10",
    "GEMINI_TEST_ANALYSIS_LIMIT": "1000"
  }
}
